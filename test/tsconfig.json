{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "rootDir": "../",
    // The root config uses "node10" for the published CommonJS build, which
    // cannot resolve the ESM-only type exports of Vitest 4 / Vite 8.
    "moduleResolution": "bundler"
  },
  "include": [
    "src/**/*.ts",
    "e2e/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
